# Server-side provider credentials. Never commit .env.
OPENAI_API_KEY=
DOCULENS_GENERATION_MODEL=gpt-4o-mini
DOCULENS_VERIFIER_MODEL=gpt-4o-mini
DOCULENS_EVALUATION_MODEL=gpt-4o-mini
DOCULENS_EMBEDDING_MODEL=text-embedding-3-small
DOCULENS_PERSIST_DIRECTORY=data/chroma
DOCULENS_COLLECTION_NAME=doculens
DOCULENS_TOP_K=5
DOCULENS_CANDIDATE_K=20
DOCULENS_MAX_REVISIONS=2
DOCULENS_MAX_HALLUCINATION_RISK=0.15
DOCULENS_REQUEST_TIMEOUT_SECONDS=120
DOCULENS_MAX_REQUEST_BYTES=16384
# Optional authentication for /query; set before exposing the server externally.
DOCULENS_API_KEY=
# Off by default; tracing can export document content to your tracing provider.
LANGSMITH_TRACING=false
RAGAS_DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false
